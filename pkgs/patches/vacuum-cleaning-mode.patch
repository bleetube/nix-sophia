+    async def _async_set_cleaning_mode(self, text: str, context: Any) -> None:
+        """Set the robot's cleaning mode from the sentence's verb before a vacuum intent starts it.
+
+        Sophia returns the same intent for "vacuum the bedroom" and "clean the
+        bedroom", and HA's vacuum intents can't carry a mode, so the verb is
+        read here: "vacuum" is vacuum only, "mop" is mop only, and "clean" or
+        anything else (or both verbs) is the default, vacuum then mop. The
+        robot's own name might be "the vacuum", so "clean" wins over it.
+        """
+        words = set(re.findall(r"[a-z]+", text.lower()))
+        mop = bool(words & {"mop", "mopping"})
+        vacuum = bool(words & {"vacuum", "vacuuming", "hoover", "hoovering"})
+        if words & {"clean", "cleaning", "cleanup"} or mop == vacuum:
+            mode = "vacuum_then_mop"
+        else:
+            mode = "mop" if mop else "vacuum"
+        try:
+            await self.hass.services.async_call(
+                "script", "set_cleaning_mode", {"mode": mode}, blocking=True, context=context
+            )
+        except Exception as err:
+            _LOGGER.error("Could not set the cleaning mode to %s: %s", mode, err)
+
